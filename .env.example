# Supabase configuration.
# Copy this file to .env.local and fill in the values from your Supabase
# project dashboard. Never commit real credentials — .env files are gitignored.

# Public Supabase project URL (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=

# Public Supabase publishable/anon key (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret Supabase key (server-only — never expose to the browser).
SUPABASE_SECRET_KEY=
